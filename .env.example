# StarkiT Production & Staging Environment Variables
# Copy to .env for local development or configure in Vercel Project Settings.
# NEVER commit real secrets or service-role keys.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin Portal Access (minimum 32 random characters for STARKIT_ADMIN_API_KEY)
STARKIT_ADMIN_API_KEY=
STARKIT_MEDIA_BUCKET=starkit-media

# Storefront Commercial Activation ('true' only after rights, stock & pricing approvals)
STARKIT_ORDERS_ENABLED=false
STARKIT_STORE_MODE=preview
STARKIT_PUBLIC_URL=http://localhost:3000

# Meta Pixel & Conversions API (Server-side only for META_ACCESS_TOKEN)
META_PIXEL_ID=1390081606323661
META_DATASET_ID=1390081606323661
META_ACCESS_TOKEN=
META_TEST_EVENT_CODE=