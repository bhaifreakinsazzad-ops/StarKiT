# ==============================================================================
# StarkiT DROP 01 — Vercel & Supabase Environment Variables
# Stored securely in Vercel Project Settings > Environment Variables (Serverless only)
# NEVER commit your actual .env file or publish your Service Role Key!
# ==============================================================================

# Supabase Project URL (from Supabase Dashboard > Project Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Service Role Key (from Supabase Dashboard > Project Settings > API > service_role secret)
# Required for server-to-server transactional calls that bypass public RLS
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Master Order Submission Switch (set to 'true' in production when ready to accept live COD orders)
STARKIT_ORDERS_ENABLED=true

